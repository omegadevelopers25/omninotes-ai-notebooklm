{
  "name": "omninotes-ai",
  "version": "1.0.0",
  "description": "OmniNotes AI - NotebookLM Auto-Notes Maker & Studio",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "dist:win": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.omninotes.ai",
    "productName": "OmniNotes AI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "server.js",
      "electron-main.js",
      "utils/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "keywords": [
    "notebooklm",
    "gemini",
    "notes-maker",
    "ai",
    "electron"
  ],
  "author": "Omega Developers",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.3.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "electron": "^34.3.0",
    "electron-builder": "^26.0.1"
  }
}
